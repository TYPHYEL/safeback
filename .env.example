# Django settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=safetaxi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME=3600
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME=86400

# Firebase
FIREBASE_CREDENTIALS=./firebase-service-account.json

# Biometric provider
# Options: mock, aws, http_api
BIOMETRIC_PROVIDER=mock
BIOMETRIC_API_URL=
BIOMETRIC_API_KEY=

# AWS Rekognition (for BIOMETRIC_PROVIDER=aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Redis / Channels
REDIS_URL=redis://redis:6379/0

# CORS
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# S3 / MinIO
USE_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Other
DJANGO_STATIC_ROOT=/var/www/static
